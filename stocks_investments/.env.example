# Copy to .env.local (git-ignored). `npx convex dev` writes the three Convex variables for you.
# The NEXT_PUBLIC_ ones are intentionally public: they only identify the deployment.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Massive market-data API key (added in Phase 6). Server-only: never prefix it with NEXT_PUBLIC_.
# MASSIVE_API_KEY=
